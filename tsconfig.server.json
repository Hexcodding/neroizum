{
  // Серверный слой проверяется БЕЗ библиотеки DOM. Это не косметика:
  // без DOM обращение к window, document или React-типам не скомпилируется,
  // то есть требование «server/ не знает про браузер» держится компилятором,
  // а не силой воли разработчика.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Нужно тесту, который сверяет список фраз защиты бандла с промптом.
    "resolveJsonModule": true,

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "types": [],
    "baseUrl": ".",
    "paths": {
      "@contracts": ["./contracts/index.ts"],
      "@contracts/*": ["./contracts/*"]
    }
  },
  "include": ["server"]
}
