# Образец настроек. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — это не рекомендация, а условие.

# ВАЖНО про приставку VITE_: всё, что с ней начинается, попадает в код,
# который скачивает браузер. Секрет с такой приставкой — это секрет,
# опубликованный в интернете. Здесь допустимы только публичные значения.

# Адрес проекта Supabase для разработки
VITE_SUPABASE_URL=https://ваш-проект-разработки.supabase.co

# Публичный ключ Supabase: на новых проектах это «Publishable key»
# (sb_publishable_...), на старых — «anon». Он и задуман публичным: доступ к
# данным ограничивает защита на уровне строк в базе, а не секретность ключа.
# Ключ из раздела «Secret keys» здесь недопустим: он даёт полный доступ к базе.
VITE_SUPABASE_ANON_KEY=

# Какое это окружение: development или production.
# От него зависит, доступны ли служебные страницы.
VITE_APP_ENV=development


# ------------------------------------------------------------------
# Ниже — секреты, которых в этом файле быть НЕ ДОЛЖНО НИКОГДА.
# Они задаются только в панели Supabase, в разделе секретов Edge Functions.
# Имена приведены точно как в server/env.ts: при отсутствии любого функция
# отказывается запускаться и пишет, какого именно не хватает.
# ------------------------------------------------------------------
# SUPABASE_URL                     адрес проекта, задан платформой
# SUPABASE_SECRET_KEYS             служебные ключи набором, заданы платформой
# SUPABASE_SERVICE_ROLE_KEY        то же по-старому, одной строкой
# NEUROIZIUM_PEPPER                серверный секрет для хеширования ключей
# NEUROIZIUM_WEBHOOK_SECRET        секрет подписи вебхука оплаты
# NEUROIZIUM_ADMIN_PASSWORD_HASH   хеш пароля админки: npm run admin-hash
# NEUROIZIUM_ADMIN_TOKEN_SECRET    секрет подписи входа в админку
# GEMINI_API_KEY                   ключ AI-модели
# NEUROIZIUM_ALLOWED_ORIGINS       разрешённые адреса через запятую, без «*»
