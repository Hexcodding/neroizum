# Образец настроек. Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — это не рекомендация, а условие.

# ВАЖНО про приставку VITE_: всё, что с ней начинается, попадает в код,
# который скачивает браузер. Секрет с такой приставкой — это секрет,
# опубликованный в интернете. Здесь допустимы только публичные значения.

# Адрес проекта Supabase для разработки
VITE_SUPABASE_URL=https://ваш-проект-разработки.supabase.co

# Публичный ключ Supabase (anon). Он и задуман публичным: доступ к данным
# ограничивает защита на уровне строк в базе, а не секретность этого ключа.
VITE_SUPABASE_ANON_KEY=

# Какое это окружение: development или production.
# От него зависит, доступны ли служебные страницы.
VITE_APP_ENV=development


# ------------------------------------------------------------------
# Ниже — секреты, которых в этом файле быть НЕ ДОЛЖНО НИКОГДА.
# Они задаются только в панели Supabase, в разделе секретов Edge Functions.
# Список приведён как памятка, что именно понадобится настроить.
# ------------------------------------------------------------------
# GEMINI_API_KEY        ключ основной AI-модели
# GROQ_API_KEY          ключ запасной AI-модели
# ADMIN_PASSWORD_HASH   хеш пароля администратора, не сам пароль
# PAYMENT_WEBHOOK_SECRET  секрет проверки подписи вебхука оплаты
# ALLOWED_ORIGINS       список разрешённых адресов через запятую, без «*»
# SERVICE_ROLE_KEY      служебный ключ Supabase, максимальные права
